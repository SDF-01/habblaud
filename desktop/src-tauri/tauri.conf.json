{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Habblaud",
  "version": "1.0.3",
  "identifier": "com.habblaud.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:4747",
    "beforeDevCommand": "node ../scripts/desktop-prepare.mjs --dev",
    "beforeBuildCommand": "node ../scripts/desktop-prepare.mjs --build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Habblaud",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/habblaud"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Virtual office for your AI agents",
    "longDescription": "Habblaud desktop app: a pixel-art virtual office that shows Cursor, Claude Code, and Codex agents live."
  },
  "plugins": {}
}
